# -----------------------------------------------------------------------------
# Conextion Environment Configuration Template
# Do NOT commit real secrets to source control.
# Copy to .env.local for local overrides.
# -----------------------------------------------------------------------------

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authoritative Primary Database (Cloud SQL PostgreSQL / Prisma)
# Pooled connection string for serverless functions
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conextion_dev?schema=public&connection_limit=10"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/conextion_dev?schema=public"

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy_DEV_MOCK_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="conextion-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="conextion-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="conextion-dev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:mockappiddev"

# Firebase Admin SDK Configuration (Server Secrets)
FIREBASE_PROJECT_ID="conextion-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@conextion-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...DEV_MOCK...\n-----END PRIVATE KEY-----\n"

# Google Cloud Storage (Server Secret)
GCS_BUCKET_NAME="conextion-dev-private-media"

# Application Security & Session Secret
SESSION_SECRET="e9b9c9f28d7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c"
