// Conextion - Enterprise Dating & Relationship Platform
// Authoritative Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  member
  moderator
  support_agent
  finance_admin
  safety_admin
  super_admin
}

enum AccountStatus {
  pending_verification
  active
  suspended
  deactivated
  banned
}

enum RelationshipIntent {
  dating
  long_term
  casual
  friendship
  open_to_options
}

enum EligibilityCheckType {
  age_gate_self_attest
  id_document_scan
  facial_age_estimation
  third_party_kyc
}

enum CheckStatus {
  pending
  approved
  rejected
  expired
}

enum VerificationType {
  selfie_liveness
  government_id
  phone_otp
  background_check
}

enum ModerationStatus {
  pending_review
  approved
  rejected
  flagged
}

enum ConsentType {
  terms_of_service
  privacy_policy
  age_certification_18plus
  community_guidelines
  cookies_analytics
}

enum InteractionType {
  like
  pass
  compliment
}

enum MatchStatus {
  active
  unmatched
}

enum ReportCategory {
  underage_suspicion
  harassment
  inappropriate_content
  spam_or_scam
  impersonation
  safety_concern
}

enum ReportStatus {
  pending
  reviewed
  dismissed
  actioned
}

enum MessageStatus {
  sent
  delivered
  read
}

enum NotificationType {
  new_match
  new_message
  security_alert
  verification_update
  safety_update
  system
}

enum CasePriority {
  low
  medium
  high
  critical
}

enum AppealStatus {
  pending
  approved
  rejected
}

enum PrivacyRequestType {
  export
  delete
}

enum PrivacyRequestStatus {
  pending
  processing
  completed
  cancelled
}

enum SubscriptionPlanTier {
  free
  plus
  premium
}

enum SubscriptionBillingInterval {
  month
  year
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id               String        @id @default(uuid())
  firebaseUid      String        @unique @map("firebase_uid")
  email            String        @unique
  phone            String?       @unique
  role             UserRole      @default(member)
  accountStatus    AccountStatus @default(pending_verification) @map("account_status")
  emailVerifiedAt  DateTime?     @map("email_verified_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  // Relationships
  profile              UserProfile?
  preferences          UserPreference?
  eligibilityChecks    EligibilityCheck[]
  verificationRecords  VerificationRecord[]  @relation("UserVerifications")
  reviewedRecords      VerificationRecord[]  @relation("ReviewerVerifications")
  photos               ProfilePhoto[]
  interests            UserInterest[]
  consents             ConsentRecord[]
  blockedUsers         Block[]               @relation("BlockerRelation")
  blockedByUsers       Block[]               @relation("BlockedRelation")
  auditLogs            AuditLog[]            @relation("ActorAuditLogs")
  initiatedInteractions Interaction[]        @relation("ActorInteractions")
  receivedInteractions  Interaction[]        @relation("TargetInteractions")
  matchesAsUser1        Match[]              @relation("User1Matches")
  matchesAsUser2        Match[]              @relation("User2Matches")
  unmatchedOthers       Match[]              @relation("UnmatchedByRelation")
  prompts               UserPrompt[]
  reportsFiled          Report[]             @relation("ReporterRelation")
  reportsReceived       Report[]             @relation("ReportedRelation")
  sentMessages          Message[]            @relation("SentMessages")
  notifications         Notification[]
  notificationPref      NotificationPreference?
  reportedCasesFiled    ModerationCase[]     @relation("CaseReporter")
  reportedCasesAgainst   ModerationCase[]    @relation("CaseReported")
  assignedCases         ModerationCase[]     @relation("AssignedCases")
  caseNotes             CaseNote[]
  appeals               Appeal[]             @relation("UserAppeals")
  reviewedAppeals       Appeal[]             @relation("ReviewerAppeals")
  privacyRequests       PrivacyDataRequest[]
  subscriptions         Subscription[]
  invoices              PaymentInvoice[]
  reconciliations       ReconciliationRecord[] @relation("ReconciliationActor")

  @@index([firebaseUid])
  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

model UserProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  displayName        String             @map("display_name")
  birthdate          DateTime
  computedAge        Int                @map("computed_age")
  gender             String
  bio                String?
  locationCity       String?            @map("location_city")
  locationCountry    String?            @map("location_country")
  latitude           Float?
  longitude          Float?
  relationshipIntent RelationshipIntent @default(dating) @map("relationship_intent")
  isVisible          Boolean            @default(true) @map("is_visible")
  isProfileComplete  Boolean            @default(false) @map("is_profile_complete")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relationships
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([computedAge])
  @@index([gender])
  @@index([relationshipIntent])
  @@index([isVisible])
  @@map("user_profiles")
}

model UserPreference {
  id                       String    @id @default(uuid())
  userId                   String    @unique @map("user_id")
  minAgePreference         Int       @default(18) @map("min_age_preference")
  maxAgePreference         Int       @default(99) @map("max_age_preference")
  maxDistanceKm            Int       @default(50) @map("max_distance_km")
  interestedInGenders      String[]  @default([]) @map("interested_in_genders")
  relationshipIntentFilter String[]  @default([]) @map("relationship_intent_filter")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Relationships
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

model EligibilityCheck {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  checkType         EligibilityCheckType @map("check_type")
  status            CheckStatus          @default(pending)
  passed            Boolean              @default(false)
  verifiedAge       Int?                 @map("verified_age")
  providerReference String?              @map("provider_reference")
  checkMetadata     Json?                @map("check_metadata")
  completedAt       DateTime?            @map("completed_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  // Relationships
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkType])
  @@index([status])
  @@map("eligibility_checks")
}

model VerificationRecord {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  verificationType VerificationType @map("verification_type")
  status           CheckStatus      @default(pending)
  reviewerNotes    String?          @map("reviewer_notes")
  reviewerId       String?          @map("reviewer_id")
  verifiedAt       DateTime?        @map("verified_at")
  expiresAt        DateTime?        @map("expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relationships
  user             User             @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  reviewer         User?            @relation("ReviewerVerifications", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([verificationType])
  @@index([status])
  @@map("verification_records")
}

model ProfilePhoto {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  storagePath      String           @map("storage_path")
  publicUrl        String           @map("public_url")
  displayOrder     Int              @default(0) @map("display_order")
  isPrimary        Boolean          @default(false) @map("is_primary")
  moderationStatus ModerationStatus @default(pending_review) @map("moderation_status")
  moderationReason String?          @map("moderation_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relationships
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPrimary])
  @@index([moderationStatus])
  @@map("profile_photos")
}

model Interest {
  id        String         @id @default(uuid())
  slug      String         @unique
  name      String         @unique
  category  String
  iconName  String?        @map("icon_name")
  createdAt DateTime       @default(now()) @map("created_at")

  // Relationships
  users     UserInterest[]

  @@index([category])
  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relationships
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([userId])
  @@index([interestId])
  @@map("user_interests")
}

model ConsentRecord {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  consentType   ConsentType @map("consent_type")
  consentVersion String     @map("consent_version")
  granted       Boolean     @default(true)
  ipAddress     String      @map("ip_address")
  userAgent     String      @map("user_agent")
  agreementHash String      @map("agreement_hash")
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relationships
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
  @@map("consent_records")
}

model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  actor        User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetEntity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Interaction {
  id        String          @id @default(uuid())
  actorId   String          @map("actor_id")
  targetId  String          @map("target_id")
  type      InteractionType
  comment   String?
  createdAt DateTime        @default(now()) @map("created_at")

  // Relationships
  actor     User            @relation("ActorInteractions", fields: [actorId], references: [id], onDelete: Cascade)
  target    User            @relation("TargetInteractions", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId])
  @@index([actorId])
  @@index([targetId])
  @@index([type])
  @@map("interactions")
}

model Match {
  id            String      @id @default(uuid())
  user1Id       String      @map("user1_id")
  user2Id       String      @map("user2_id")
  status        MatchStatus @default(active)
  matchedAt     DateTime    @default(now()) @map("matched_at")
  unmatchedAt   DateTime?   @map("unmatched_at")
  unmatchedById String?     @map("unmatched_by_id")

  // Relationships
  user1         User        @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User        @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  unmatchedBy   User?       @relation("UnmatchedByRelation", fields: [unmatchedById], references: [id], onDelete: SetNull)
  conversation  Conversation?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
  @@map("matches")
}

model UserPrompt {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  promptText String   @map("prompt_text")
  answer     String
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relationships
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_prompts")
}

model Report {
  id         String         @id @default(uuid())
  reporterId String         @map("reporter_id")
  reportedId String         @map("reported_id")
  category   ReportCategory
  details    String?
  status     ReportStatus   @default(pending)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relationships
  reporter   User           @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User           @relation("ReportedRelation", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
  @@map("reports")
}

model Conversation {
  id            String    @id @default(uuid())
  matchId       String    @unique @map("match_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relationships
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([matchId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String        @map("conversation_id")
  senderId        String        @map("sender_id")
  content         String
  clientMessageId String?       @unique @map("client_message_id")
  status          MessageStatus @default(sent)
  createdAt       DateTime      @default(now()) @map("created_at")
  readAt          DateTime?     @map("read_at")

  // Relationships
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  preview   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  // Relationships
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  emailMatches   Boolean  @default(true) @map("email_matches")
  emailMessages  Boolean  @default(false) @map("email_messages")
  inAppMatches   Boolean  @default(true) @map("in_app_matches")
  inAppMessages  Boolean  @default(true) @map("in_app_messages")
  securityAlerts Boolean  @default(true) @map("security_alerts")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relationships
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model ModerationCase {
  id           String         @id @default(uuid())
  reporterId   String         @map("reporter_id")
  reportedId   String         @map("reported_id")
  category     ReportCategory
  priority     CasePriority   @default(medium)
  status       ReportStatus   @default(pending)
  details      String?
  evidence     Json?
  assignedToId String?        @map("assigned_to_id")
  resolution   String?
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relationships
  reporter     User           @relation("CaseReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported     User           @relation("CaseReported", fields: [reportedId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedCases", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        CaseNote[]
  appeals      Appeal[]

  @@index([reporterId])
  @@index([reportedId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@map("moderation_cases")
}

model CaseNote {
  id        String         @id @default(uuid())
  caseId    String         @map("case_id")
  authorId  String         @map("author_id")
  note      String
  createdAt DateTime       @default(now()) @map("created_at")

  // Relationships
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_notes")
}

model Appeal {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  caseId        String?         @map("case_id")
  reason        String
  status        AppealStatus    @default(pending)
  reviewerId    String?         @map("reviewer_id")
  decisionNotes String?         @map("decision_notes")
  reviewedAt    DateTime?       @map("reviewed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relationships
  user          User            @relation("UserAppeals", fields: [userId], references: [id], onDelete: Cascade)
  reviewer      User?           @relation("ReviewerAppeals", fields: [reviewerId], references: [id], onDelete: SetNull)
  case          ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("appeals")
}

model PrivacyDataRequest {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  type             PrivacyRequestType
  status           PrivacyRequestStatus @default(pending)
  requestedAt      DateTime             @default(now()) @map("requested_at")
  completedAt      DateTime?            @map("completed_at")
  scheduledPurgeAt DateTime?            @map("scheduled_purge_at")
  payload          Json?

  // Relationships
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("privacy_data_requests")
}

model Subscription {
  id                     String                      @id @default(uuid())
  userId                 String                      @map("user_id")
  planTier               SubscriptionPlanTier        @default(free) @map("plan_tier")
  status                 SubscriptionStatus          @default(active)
  provider               String                      @default("stripe")
  providerCustomerId     String?                     @map("provider_customer_id")
  providerSubscriptionId String?                     @unique @map("provider_subscription_id")
  providerPriceId        String?                     @map("provider_price_id")
  billingInterval        SubscriptionBillingInterval? @map("billing_interval")
  currentPeriodStart     DateTime?                   @map("current_period_start")
  currentPeriodEnd       DateTime?                   @map("current_period_end")
  cancelAtPeriodEnd      Boolean                     @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?                   @map("canceled_at")
  endedAt                DateTime?                   @map("ended_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  // Relationships
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices               PaymentInvoice[]

  @@index([userId])
  @@index([status])
  @@index([planTier])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

model PaymentInvoice {
  id                      String         @id @default(uuid())
  userId                  String         @map("user_id")
  subscriptionId          String?        @map("subscription_id")
  providerInvoiceId       String?        @unique @map("provider_invoice_id")
  providerPaymentIntentId String?        @map("provider_payment_intent_id")
  amountCents             Int            @map("amount_cents")
  currency                String         @default("usd")
  status                  PaymentStatus  @default(pending)
  receiptUrl              String?        @map("receipt_url")
  hostedInvoiceUrl        String?        @map("hosted_invoice_url")
  billingReason           String?        @map("billing_reason")
  refundedAmountCents     Int            @default(0) @map("refunded_amount_cents")
  refundReason            String?        @map("refund_reason")
  createdAt               DateTime       @default(now()) @map("created_at")

  // Relationships
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription            Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payment_invoices")
}

model WebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @map("provider_event_id")
  provider        String    @default("stripe")
  eventType       String    @map("event_type")
  payload         Json
  processed       Boolean   @default(false)
  error           String?
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([providerEventId])
  @@index([eventType])
  @@index([processed])
  @@map("webhook_events")
}

model ReconciliationRecord {
  id              String    @id @default(uuid())
  reconciledById  String?   @map("reconciled_by_id")
  totalChecked    Int       @map("total_checked")
  mismatchesFound Int       @map("mismatches_found")
  details         Json
  status          String    @default("matched")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relationships
  reconciledBy    User?     @relation("ReconciliationActor", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([reconciledById])
  @@index([status])
  @@map("reconciliation_records")
}
